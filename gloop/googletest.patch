+/*
+// Returns the current OS stack trace as an std::string.  Parameters:
+//
+//   max_depth  - the maximum number of stack frames to be included
+//                in the trace.
+//   skip_count - the number of top frames to be skipped; doesn't count
+//                against max_depth.
+//
+std::string Google3OsStackTraceGetter::CurrentStackTrace(int max_depth,
+                                                         int skip_count)
+    GTEST_LOCK_EXCLUDED_(mutex_) {
+  if (max_depth == 0) {
+    return "";
+  }
+
+  if (max_depth < 0 || max_depth > kMaxStackTraceDepth) {
+    max_depth = kMaxStackTraceDepth;
+  }
+
+  std::vector<std::string> stack;
+  // If debug info is present, dwarf2reader::GetAddr2LineStackTrace()
+  // gives us stack traces with file names and line numbers like this:
+  //
+  //   0x08059552: Bar() @ foo/bar/foo_test.cc:372
+  //   0x08059581: Foo() @ foo/bar/foo_test.cc:377
+  //
+  // If debug info is not present, the function gives us stack traces
+  // without file names and line numbers like this:
+  //
+  //   0x08059552: Bar() @ ??:??
+  //   0x08059581: Foo() @ ??:??
+  //
+  // Skips whatever number of frames the caller requested, plus this
+  // function and GetAddr2LineStackTrace() +
+  // GetAddressQueriesForStackTrace().
+  dwarf2reader::GetAddr2LineStackTrace(&stack, max_depth, skip_count + 3);
+
+  std::vector<void*> raw_stack(max_depth);
+  // Skips the frames requested by the caller, plus this function.
+  const int raw_stack_size =
+      absl::GetStackTrace(&raw_stack[0], max_depth, skip_count + 1);
+  void* caller_frame = nullptr;
+  {
+    MutexLock lock(mutex_);
+    caller_frame = caller_frame_;
+  }
+
+  std::string result;
+  for (int i = 0; i < stack.size() && i < raw_stack_size; i++) {
+    if (raw_stack[i] == caller_frame &&
+        !GTEST_FLAG_GET(show_internal_stack_frames)) {
+      // Add a marker to the trace and stop adding frames.
+      result += OsStackTraceGetter::kElidedFramesMarker;
+      result += "\n";
+      break;
+    }
+
+    result += stack[i] + "\n";
+  }
+
+  return result;
+}
+
+void Google3OsStackTraceGetter::UponLeavingGTest()
+    GTEST_LOCK_EXCLUDED_(mutex_) {
+  // Skips UponLeavingGTest, GetSymbolizedStackTrace, and the calling
+  // frame, since only the address below the caller stays constant.
+  void* caller_frame;
+  if (absl::GetStackTrace(&caller_frame, 1, 3) <= 0) caller_frame = nullptr;
+
+  MutexLock lock(mutex_);
+  caller_frame_ = caller_frame;
+}
+*/
+
+GoogleProcessStateListener::~GoogleProcessStateListener() = default;
+
+void GoogleProcessStateListener::OnEnvironmentsSetUpEnd(
+    const UnitTest& unit_test) {
+  base::process_state::ReportChange(base::process_state::kAppInitDone, nullptr);
+}
+
+void GoogleProcessStateListener::OnEnvironmentsTearDownStart(
+    const UnitTest& unit_test) {
+  base::process_state::ReportChange(base::process_state::kShutdownBegin,
+                                    nullptr);
+}
+
+void GoogleProcessStateListener::OnTestSuiteStart(const TestSuite& test_suite) {
+  base::process_state::ReportChange(base::process_state::kTestSuiteStart,
+                                    test_suite.name());
+}
+
+void GoogleProcessStateListener::OnTestSuiteEnd(const TestSuite& test_suite) {
+  base::process_state::ReportChange(base::process_state::kTestSuiteEnd,
+                                    test_suite.name());
+}
+
+void GoogleProcessStateListener::OnTestStart(const TestInfo& test_info) {
+  const std::string test_suite_name = test_info.test_suite_name();
+  const std::string qualified_test_name =
+      test_suite_name + "." + test_info.name();
+  base::process_state::ReportChange(base::process_state::kTestStart,
+                                    qualified_test_name.c_str());
+}
+
+void GoogleProcessStateListener::OnTestEnd(const TestInfo& test_info) {
+  const std::string test_suite_name = test_info.test_suite_name();
+  const std::string qualified_test_name =
+      test_suite_name + "." + test_info.name();
+  base::process_state::ReportChange(base::process_state::kTestEnd,
+                                    qualified_test_name.c_str());
+}
+
+::std::vector<std::string> GetGoogle3DeathTestCommandLineArgs() {
+  //return {"--logtostderr"};
+  return {};
+}
+
+// For b/11021341, disable (slow) AddressToLineNumberDecorator.
+void Google3DeathTestChildSetup() {
+  // For b/11021341, disable (slow) AddressToLineNumberDecorator.
+  absl::debugging_internal::SetSymbolDecoratorFactory(nullptr);
+  // Also suppress (very slow) printing stack traces for all threads.
+  absl::SetFlag(&FLAGS_suppress_failure_output, true);
+}
