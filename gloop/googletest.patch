+void ParseGoogleTestFlagsOnly(int* argc, char** argv);
+void InitGoogleTestForGoogle3(int* argc, char** argv) {
+  for (int i = 0; i != *argc; i++) {
+    g_argvs.push_back(StreamableToString(argv[i]));
+  }
+  ParseGoogleTestFlagsOnly(argc, argv);
+
+  // InitGoogle moves our copy of argv to eat the flags, instead of
+  // modifying it in place. We have to shift them in place later.
+  // Otherwise, the caller to InitGoogleTest() will have an argv pointing to
+  // the wrong values.
+  char** argv_copy = argv;
+  ::InitGoogle(argv[0], argc, &argv, true);
+  // Fix the source argv:
+  std::copy(argv, argv + *argc, argv_copy);
+  internal::GetUnitTestImpl()->PostFlagParsingInit();
+}
+
+void InitGoogleTestForGoogle3(int* argc, wchar_t** argv) {
+  LOG(FATAL) << "InitGoogleTest(int*,wchar_t**) not supported in google3 mode.";
+}
