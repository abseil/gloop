# Gloop requires C++20
build --cxxopt=-std=c++20 --host_cxxopt=-std=c++20

# Enable threadsafe death tests and Abseil flags support for GTest.
build --copt=-DGTEST_DEFAULT_DEATH_TEST_STYLE='"threadsafe"' --host_copt=-DGTEST_DEFAULT_DEATH_TEST_STYLE='"threadsafe"'
build --define=absl=1

# Gloop does not support exceptions.
build --copt=-fno-exceptions --host_copt=-fno-exceptions

# Gloop only supports building with unsigned chars.
build --copt=-funsigned-char --host_copt=-funsigned-char

# Disable frame pointer omission to aid debugging.
build --copt=-fno-omit-frame-pointer

# Disable warnings from dependencies.
build --per_file_copt=-external/.*@-Wno-thread-safety-analysis,-Wno-character-conversion,-Wno-unused-function
build --host_per_file_copt=-external/.*@-Wno-deprecated-declarations

# Enable all recommended warnings by default, and treat them as errors.
build --copt=-Werror
build --copt=-Wall --copt=-Wmost --copt=-Wextra
build --copt=-Wthread-safety

# Disable any warnings we don't support.
build --copt=-Wno-unused-private-field # False positives that ignore [[maybe_unused]]
build --copt=-Wno-deprecated-declarations # Gloop contains a lot of deprecated code
build --copt=-Wno-nullability-completeness # Nullability annotations are not yet enforced
build --copt=-Wno-uninitialized-const-pointer # Cheap ASLR randomization false-positives
build --copt=-Wno-c++11-compat # We don't support C++11
build --copt=-Wno-missing-field-initializers # We take advantage of default zero initialization

# Noisy warnings that aren't enabled internally.
build --copt=-Wno-sign-compare
build --copt=-Wno-unused-parameter
build --copt=-Wno-implicit-float-conversion
build --copt=-Wno-unused-command-line-argument
build --copt=-Wno-deprecated-volatile

# CI configurations

# Register explicit C++ toolchain from @docker_toolchain.
# This can be overridden by our test docker images to inject our own toolchains.
build --extra_toolchains=@docker_toolchain//:all

test --test_output=errors --keep_going

build:dbg --compilation_mode=dbg
build:opt --compilation_mode=opt

build:san-common --config=dbg --strip=never --copt=-Og

build:asan --config=san-common
build:asan --//gloop:sanitizer=asan
build:asan --features=asan
build:asan --copt=-O2 # TODO Workaround cord/status false positive
test:asan --test_tag_filters=-nosan,-noasan
test:asan --build_tag_filters=-nosan,-noasan

build:ubsan --config=san-common
build:ubsan --//gloop:sanitizer=ubsan
build:ubsan --features=ubsan
build:ubsan --copt=-fno-sanitize=function --copt=-fno-sanitize=vptr --copt=-fno-sanitize=nonnull-attribute
build:ubsan --copt=-D__SANITIZE_UNDEFINED__=1
build:ubsan --copt=-O2
test:ubsan --test_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
test:ubsan --test_tag_filters=-nosan,-noubsan
test:ubsan --build_tag_filters=-nosan,-noubsan

build:msan --config=san-common
build:msan --//gloop:sanitizer=msan
build:msan --copt=-fno-sanitize-memory-use-after-dtor --copt=-fsanitize-memory-track-origins=0
build:msan --copt=-O2 # Avoids false positives from -Og
build:msan --copt=-DLINUX_SYSCALL_ENABLE_HOOKS
build:msan --features=msan
test:msan --test_env=MSAN_OPTIONS=symbolize=1:fast_unwind_on_malloc=0:poison_in_dtor=0
test:msan --test_tag_filters=-nosan,-nomsan
test:msan --build_tag_filters=-nosan,-nomsan

build:tsan --config=san-common
build:tsan --//gloop:sanitizer=tsan
build:tsan --copt=-DLINUX_SYSCALL_ENABLE_HOOKS
build:tsan --features=tsan
test:tsan --test_tag_filters=-nosan,-notsan
test:tsan --build_tag_filters=-nosan,-notsan

build:libstdc++-base --features=libstdc++ --//gloop:stdlib=libstdc++
build:libstdc++ --config=libstdc++-base --config=asan --copt=-DGLOOP_I_ACKNOWLEDGE_THAT_GLOOP_DOES_NOT_SUPPORT_LIBSTDCXX=1  --host_copt=-DGLOOP_I_ACKNOWLEDGE_THAT_GLOOP_DOES_NOT_SUPPORT_LIBSTDCXX=1

# Remote build configuration for Gloop CI.
build:remote-base --define=EXECUTOR=remote
build:remote-base --remote_cache=grpcs://us-central1-remotebuildexecution.googleapis.com
build:remote-base --remote_executor=grpcs://us-central1-remotebuildexecution.googleapis.com
build:remote-base --remote_instance_name=projects/google.com:absl-177019/instances/gloop-ci-central
build:remote-base --remote_timeout=3600 --bes_timeout=600s
build:remote-base --jobs=800
build:remote-base --remote_download_minimal

build:remote --config=remote-base
build:remote --extra_execution_platforms=//gloop/ci:rbe
build:remote --host_platform=//gloop/ci:rbe
build:remote --platforms=//gloop/ci:rbe

build:remote-arm --config=remote-base
build:remote-arm --extra_execution_platforms=//gloop/ci:rbe-arm
build:remote-arm --host_platform=//gloop/ci:rbe-arm
build:remote-arm --platforms=//gloop/ci:rbe-arm

# Fuzzing configuration.
try-import %workspace%/fuzztest.bazelrc
