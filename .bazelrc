build --cxxopt=-std=c++20 --host_cxxopt=-std=c++20

common --define=absl=1 # Tell gtest to use Abseil
test  --test_sharding_strategy=disabled --cache_test_results=no --local_test_jobs=1 --local_resources=memory=HOST_RAM*.3 --local_resources=cpu=HOST_CPUS*.3
test --test_arg=--gtest_death_test_style=threadsafe

test --test_output=errors --keep_going

# Gloop does not support exceptions.
build --copt=-fno-exceptions

# Gloop only supports building with unsigned chars.
build --copt=-funsigned-char

# Enable hardware-specific optimizations.
build --copt=-march=x86-64-v2

# Disable frame pointer omission to aid debugging.
build --copt=-fno-omit-frame-pointer

# Disable warnings from dependencies.
build --per_file_copt=-external/.*@-Wno-thread-safety-analysis,-Wno-character-conversion
build --host_per_file_copt=-external/.*@-Wno-deprecated-declarations
build --host_copt=-Wno-error
build --host_copt=-Wno-deprecated-declarations
build --host_copt=-Wno-nullability-completeness
build --host_copt=-Wno-c++11-compat

# Disable any warnings we don't support, and treat the rest as errors.
build --copt=-Werror
build --copt=-Wno-unused-private-field # False positives that ignore [[maybe_unused]]
build --copt=-Wno-deprecated-declarations # Gloop contains a lot of deprecated code
build --copt=-Wno-nullability-completeness # Nullability annotations are not yet enforced
build --copt=-Wno-uninitialized-const-pointer # Cheap ASLR randomization false-positives
build --copt=-Wno-c++11-compat # We don't support C++11
build --copt=-Wno-implicit-float-conversion
build --copt=-Wno-unused-command-line-argument
build --copt=-Wno-deprecated-volatile

test --test_output=errors

build:dbg --compilation_mode=dbg
build:opt --compilation_mode=opt

build:san-common --config=dbg --strip=never --copt=-Og

build:asan --config=san-common
build:asan --//gloop:sanitizer=asan
build:asan --copt=-fsanitize=address --linkopt=-fsanitize=address
build:asan --copt=-O2 # TODO Workaround cord/status false positive
test:asan --test_tag_filters=-nosan,-noasan

build:ubsan --config=san-common
build:ubsan --//gloop:sanitizer=ubsan
build:ubsan --copt=-fsanitize=undefined --linkopt=-fsanitize=undefined
build:ubsan --copt=-fno-sanitize=function --copt=-fno-sanitize=vptr --copt=-fno-sanitize=nonnull-attribute
build:ubsan --copt=-D__SANITIZE_UNDEFINED__=1
build:ubsan --copt=-O2
test:ubsan --test_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
test:ubsan --test_tag_filters=-nosan,-noubsan

build:msan --config=san-common
build:msan --//gloop:sanitizer=msan
build:msan --copt=-fsanitize=memory --linkopt=-fsanitize=memory
build:msan --copt=-fno-sanitize-memory-use-after-dtor --copt=-fsanitize-memory-track-origins=0
build:msan --copt=-O2 # Avoids false positives from -Og
build:msan --copt=-DLINUX_SYSCALL_ENABLE_HOOKS
test:msan --test_env=MSAN_OPTIONS=symbolize=1:fast_unwind_on_malloc=0:poison_in_dtor=0
test:msan --test_tag_filters=-nosan,-nomsan

build:tsan --config=san-common
build:tsan --//gloop:sanitizer=tsan
build:tsan --copt=-fsanitize=thread --linkopt=-fsanitize=thread
build:tsan --copt=-DLINUX_SYSCALL_ENABLE_HOOKS
test:tsan --test_tag_filters=-nosan,-notsan